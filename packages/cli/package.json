{
  "name": "@octocodeai/freellama",
  "version": "0.1.0",
  "description": "Local Ollama model gateway, router, and benchmarker — CLI. Wraps the compiled Rust binary from packages/rust-core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/FreeLlama.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bgauryy/FreeLlama#readme",
  "bugs": "https://github.com/bgauryy/FreeLlama/issues",
  "keywords": [
    "ollama",
    "local-llm",
    "gateway",
    "coding-agent"
  ],
  "type": "module",
  "bin": "bin/freellama.mjs",
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"process.stdout.write('freellama CLI launcher ready\\n')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "Apache-2.0 OR MIT",
  "optionalDependencies": {
    "@octocodeai/freellama-native-darwin-arm64": "0.1.0",
    "@octocodeai/freellama-native-darwin-x64": "0.1.0",
    "@octocodeai/freellama-native-linux-arm64-gnu": "0.1.0",
    "@octocodeai/freellama-native-linux-arm64-musl": "0.1.0",
    "@octocodeai/freellama-native-linux-x64-gnu": "0.1.0",
    "@octocodeai/freellama-native-linux-x64-musl": "0.1.0",
    "@octocodeai/freellama-native-win32-arm64-msvc": "0.1.0",
    "@octocodeai/freellama-native-win32-x64-msvc": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
