{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freellama.local/schemas/suite.schema.json",
  "title": "FreeLlama agent benchmark suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "suite_version", "created_at", "last_reviewed_at", "review_due_at", "visibility", "fixture", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "last_reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "review_due_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "visibility": {"enum": ["public_development", "private_held_out"]},
    "generated_at": {"type": "string"},
    "variant_seed_hash": {"type": "string"},
    "source_suite": {"type": "string"},
    "fixture": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "title", "tier", "category", "prompt", "requirements", "timeout_seconds", "checks", "rubric"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"},
          "title": {"type": "string"},
          "tier": {"enum": ["basic", "core", "advanced", "complex"]},
          "category": {"type": "string"},
          "prompt": {"type": "string", "minLength": 20},
          "requirements": {"type": "array", "items": {"enum": ["filesystem", "shell", "tools", "skills", "mcp"]}, "uniqueItems": true},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "weight"], "properties": {"type": {"type": "string"}, "weight": {"type": "number", "exclusiveMinimum": 0}}}},
          "rubric": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
