{
  "name": "freellama-workspace",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Workspace root for FreeLlama's internal Rust core, portable JavaScript entry points, and per-platform native artifact packages.",
  "workspaces": [
    "packages/mcp",
    "packages/cli",
    "packages/native/*"
  ],
  "napi": {
    "binaryName": "freellama",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "yarn build:rust && yarn build:native && yarn build:js",
    "build:js": "yarn workspaces foreach -A --topological --exclude freellama-workspace run build",
    "build:native": "node scripts/build-native.mjs",
    "build:rust": "cargo build --release",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn lint:rust && yarn lint:js",
    "lint:js": "yarn typecheck",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "format": "cargo fmt --all",
    "test": "yarn test:js && yarn test:rust",
    "test:js": "vitest run",
    "test:integration": "vitest run -c packages/mcp/vitest.integration.config.ts",
    "test:e2e": "vitest run -c packages/mcp/vitest.e2e.config.ts",
    "test:rust": "cargo test --workspace",
    "test:all": "yarn typecheck && yarn test && yarn test:release && yarn test:integration && yarn test:e2e",
    "verify:production": "yarn build && yarn lint:rust && yarn test:all && yarn release:verify:publish",
    "release:version": "node scripts/set-version.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release-packages.mjs",
    "release:verify:publish": "FREELLAMA_REQUIRE_ALL_PLATFORMS=1 node scripts/verify-release-packages.mjs",
    "build:licenses": "node scripts/bundle-licenses.mjs",
    "test:release": "node --test scripts/test-release-packages.mjs scripts/test-release-registry.mjs",
    "release:verify:registry": "node scripts/verify-release-registry.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "author": "Guy Bary",
  "license": "Apache-2.0 OR MIT",
  "packageManager": "yarn@4.9.1"
}
